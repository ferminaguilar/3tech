{#
/**
 * @file
 * Theme implementation to display a single Drupal page while offline (maintenance mode).
 * 3 Tech - Maintenance Page Template
 * All available variables are mirrored in page.html.twig.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessMaintenancePage()
 *
 * @ingroup themeable
 */
#}
<style>
  html, body {
    margin: 0;
    padding: 0;
    background-color: #000000 !important;
    color: #ffffff !important;
    font-family: "Source Sans Pro Web", "Helvetica Neue", Helvetica, Roboto, Arial, sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }
  .maintenance-wrapper {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    background-color: #000000;
    color: #ffffff;
    box-sizing: border-box;
  }
  .maintenance-inner {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-left: calc((100vw - 1040px) / 2);
    padding-right: 0;
    box-sizing: border-box;
  }
  @media (max-width: 1080px) {
    .maintenance-inner {
      padding-left: 1.5rem;
    }
  }
  .maintenance-col-text {
    flex: 1 1 350px;
    max-width: 600px;
    color: #ffffff;
    box-sizing: border-box;
  }
  .maintenance-col-text h1, 
  .maintenance-col-text h2, 
  .maintenance-col-text h3,
  .maintenance-col-text p,
  .maintenance-col-text div,
  .maintenance-col-text span {
    color: #ffffff !important;
  }
  .maintenance-col-text a {
    color: #ffffff !important;
    text-decoration: underline;
  }
  .maintenance-site-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #ffffff;
  }
  .maintenance-title {
    font-size: 2.25rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: #ffffff;
  }
  .maintenance-slogan {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    opacity: 0.9;
    color: #ffffff;
  }
  .maintenance-content {
    font-size: 1rem;
    line-height: 1.6;
    color: #ffffff;
  }
  .maintenance-col-logo {
    flex: 1 1 300px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    text-align: left;
    padding-left: 10px;
    margin-left: 0;
    background-color: #face0b;
  }
  .maintenance-logo-img {
    max-width: 100%;
    max-height: 70vh;
    height: auto;
    display: block;
    margin-left: auto;
    margin-right: 0;
  }
  @media (max-width: 768px) {
    .maintenance-inner {
      flex-direction: column-reverse;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      text-align: center;
    }
    .maintenance-col-logo {
      justify-content: center;
      text-align: center;
      width: 100%;
    }
    .maintenance-logo-img {
      margin-left: auto;
      margin-right: auto;
    }
    .maintenance-col-text {
      text-align: center;
      max-width: 100%;
    }
  }
</style>

<div class="maintenance-wrapper bg-black text-white">
  <div class="maintenance-inner">
    
    <!-- Column 1: Text Content (Aligned with container margin) -->
    <div class="maintenance-col-text">
      {% if site_name %}
        <div class="maintenance-site-name">{{ site_name }}</div>
      {% endif %}

      {% if title %}
        <h1 class="maintenance-title">{{ title }}</h1>
      {% endif %}

      {% if site_slogan %}
        <div class="maintenance-slogan">{{ site_slogan }}</div>
      {% endif %}

      <div class="maintenance-content">
        {% if page.content %}
          {{ page.content }}
        {% else %}
          <p>{{ 'The site is currently under maintenance. We will be back online shortly. Thank you for your patience.'|t }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Column 2: Logo (Touches right edge of browser) -->
    <div class="maintenance-col-logo padding-y-1">
      {% if logo %}
        <a href="{{ front_page }}" title="{{ 'Home'|t }}" rel="home" class="display-inline-block">
          <img src="{{ logo }}" alt="{{ site_name ? site_name : 'Home'|t }}" class="maintenance-logo-img" />
        </a>
      {% endif %}
    </div>
  </div>
</div>


