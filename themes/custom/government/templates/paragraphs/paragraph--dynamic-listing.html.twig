{#
/**
 * @file
 * Theme override for Dynamic Listing paragraph matching Government Town Highlights & Events.
 */
#}
{% set sidebar_pos = paragraph.field_sidebar_position.value|default('left') %}
{% set is_flipped = (sidebar_pos == 'right') %}
{% set bg_color = paragraph.field_background_color.value|default(is_flipped ? 'primary' : 'white') %}
{% set section_id = (paragraph.field_listing_heading.value ? paragraph.field_listing_heading.value|clean_class : (paragraph.field_title.value ? paragraph.field_title.value|clean_class : 'section-' ~ paragraph.id.value)) %}

<section
  id="{{ section_id }}"
  class="government-listing-section position-relative overflow-hidden {{ is_flipped ? 'is-layout-flipped' : 'is-layout-default' }} section-bg-{{ bg_color }}">


  {# Split Background Layer: Spans from screen edge to the 1/3 column boundary #}
  {% if content.field_background_image|render|trim %}
  <div class="{{ is_flipped ? 'government-split-right-bg' : 'government-split-left-bg' }}">
    <div class="split-bg-image">
      {{ content.field_background_image }}
    </div>
    <div class="split-bg-overlay"></div>
  </div>
  {% endif %}

  <div class="grid-container position-relative z-10 height-full">
    <div class="grid-row grid-gap-6 flex-align-stretch height-full {{ is_flipped ? 'desktop:flex-row-reverse' : '' }}">

      {# 1/3 Column: Title + Body Text / Information #}
      <div
        class="grid-col-12 desktop:grid-col-4 display-flex flex-column justify-center government-quote-col {{ is_flipped ? 'government-right-quote-col' : 'government-left-col' }}">
        <div class="government-highlight-quote">
          {% if paragraph.field_title.value %}
          <h2 class="font-sans-2xl text-bold line-height-sans-2 margin-0">
            {{ paragraph.field_title.value }}
          </h2>
          {% endif %}

          {% if content.field_body|render|trim %}
          <div class="government-highlight-body margin-top-2">
            {{ content.field_body }}
          </div>
          {% endif %}
        </div>
      </div>

      {# 2/3 Column: Main Heading/Subheading + News/Events List #}
      <div
        class="grid-col-12 desktop:grid-col-8 display-flex flex-column justify-center government-main-col {{ is_flipped ? 'government-left-main-col' : 'government-right-col' }}">
        <div class="government-highlight-main width-full">

          {# Section Header #}
          {% if paragraph.field_listing_heading.value or paragraph.field_listing_subheading.value %}
          <div class="government-highlight-header margin-bottom-4">
            {% if paragraph.field_listing_heading.value %}
            <h2 class="font-sans-2xl text-bold margin-0 margin-bottom-1 text-primary-darkest">
              {{ paragraph.field_listing_heading.value }}
            </h2>
            {% endif %}
            {% if paragraph.field_listing_subheading.value %}
            <h4 class="font-sans-md text-base-dark margin-0 dekoline">
              {{ paragraph.field_listing_subheading.value }}
            </h4>
            {% endif %}
          </div>
          {% endif %}

          {# Rendered Content: Text Description (field_listing_body) and/or View Ref (field_view_ref) #}
          {% if content.field_listing_body|render|trim %}
            <div class="government-listing-body usa-prose margin-bottom-3">
              {{ content.field_listing_body }}
            </div>
          {% endif %}

          {% if content.field_view_ref|render|trim %}
            <div class="government-highlight-posts">
              {{ content.field_view_ref }}
            </div>
          {% endif %}

          {# Bottom Button #}
          {% if paragraph.field_link.0.url %}
            <div class="margin-top-4">
              <a href="{{ paragraph.field_link.0.url }}" class="usa-button usa-button--outline usa-button--inverse">
                {{ paragraph.field_link.0.title|default('Learn More'|t) }} <span class="margin-left-1" aria-hidden="true">→</span>
              </a>
            </div>
          {% elseif content.field_view_ref|render|trim %}
            <div class="margin-top-4">
              {% set btn_url = is_flipped ? '/events' : '/news' %}
              {% set btn_text = is_flipped ? 'More Events' : 'More News' %}
              <a href="{{ btn_url }}" class="usa-button usa-button--outline usa-button--inverse">
                {{ btn_text|t }} <span class="margin-left-1" aria-hidden="true">→</span>
              </a>
            </div>
          {% endif %}

        </div>
      </div>

    </div>
  </div>
</section>