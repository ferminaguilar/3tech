<div class="grid-col-12 tablet:grid-col-6 desktop:grid-col-3 margin-bottom-3 desktop:margin-bottom-0">
  <div class="government-service-card padding-3 height-full display-flex flex-column">
    {% set icon_val = paragraph.field_service_icon.value|trim %}
    {% if icon_val %}
      <div class="service-card__icon margin-bottom-2">
        {% if '<svg' in icon_val %}
          {{ icon_val|raw }}
        {% elseif 'http' in icon_val or '.png' in icon_val or '.svg' in icon_val or '/' in icon_val %}
          <img src="{{ icon_val }}" alt="" width="56" height="56" class="service-card-img" />
        {% else %}
          {# Font Awesome icon handling #}
          {% if 'fa-solid' in icon_val or 'fa-regular' in icon_val or 'fa-brands' in icon_val or 'fas ' in icon_val or 'far ' in icon_val or 'fab ' in icon_val %}
            <i class="{{ icon_val }} fa-2x" aria-hidden="true"></i>
          {% elseif 'fa-' in icon_val %}
            <i class="fa-solid {{ icon_val }} fa-2x" aria-hidden="true"></i>
          {% else %}
            <i class="fa-solid fa-{{ icon_val }} fa-2x" aria-hidden="true"></i>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
    <div class="service-card__header margin-bottom-1">
      <h3 class="service-card__title font-sans-md text-bold margin-0">
        {% if paragraph.field_service_link.0.url %}
          <a href="{{ paragraph.field_service_link.0.url }}" class="service-card__link text-no-underline">
            {{ paragraph.field_service_title.value }}
          </a>
        {% else %}
          {{ paragraph.field_service_title.value }}
        {% endif %}
      </h3>
    </div>
    <div class="service-card__body">
      <p class="font-sans-2xs text-base-dark margin-0 line-height-sans-4">
        {{ paragraph.field_service_summary.value }}
      </p>
    </div>
  </div>
</div>