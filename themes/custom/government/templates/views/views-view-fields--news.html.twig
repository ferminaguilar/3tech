{#
/**
 * @file
 * Theme override for News view row fields matching Government front_post item.
 */
#}
<div class="government-post-item display-flex flex-row flex-align-start">
  {% if fields.field_image %}
    <div class="imgwrap margin-right-3 flex-shrink-0">
      {{ fields.field_image.content }}
    </div>
  {% endif %}

  <div class="post-content display-flex flex-column flex-fill">
    <h3 class="post-title font-sans-md text-bold margin-top-0 margin-bottom-1 line-height-sans-2">
      {{ fields.title.content }}
    </h3>

    <p class="meta font-sans-3xs text-base margin-0 margin-bottom-1 display-flex flex-align-center">
      {% if fields.created and fields.created.content|striptags|trim %}
        <span class="post-date">{{ fields.created.content }}<span class="divider margin-x-1">|</span></span>
      {% endif %}
      {% if fields.field_category and fields.field_category.content|striptags|trim %}
        <span class="categs text-primary text-bold">{{ fields.field_category.content }}</span>
      {% endif %}
    </p>

    {% if fields.field_summary and fields.field_summary.content|striptags|trim %}
      <p class="teaser font-sans-2xs text-base-dark margin-0 line-height-sans-4">
        {{ fields.field_summary.content|striptags|slice(0, 160) }}...
      </p>
    {% endif %}
  </div>
</div>
