    'provider' => 'wa',
    'base' => [
      'field' => 'id',
      'title' => t('Passkeys'),
      'help' => t('Stored WebAuthn credentials.'),
      'access query tag' => 'wa_access',
    ],
  ];

  $data['wa']['id'] = [
    'title' => t('ID'),
    'help' => t('Unique credential ID.'),
    'field' => [
      'id' => 'numeric',
      'click sortable' => TRUE,
    ],
    'filter' => ['id' => 'numeric'],
    'sort' => ['id' => 'standard'],
  ];

  $data['wa']['uid'] = [
    'title' => t('User ID'),
    'help' => t('The {users}.uid that owns the credential.'),
    'field' => [
      'id' => 'numeric',
      'click sortable' => TRUE,
    ],
    'filter' => ['id' => 'numeric'],
    'sort' => ['id' => 'standard'],
    'relationship' => [
      'title' => t('User'),
      'help' => t('Relate passkeys to their owners.'),
      'id' => 'standard',
      'base' => 'users_field_data',
      'base field' => 'uid',
      'label' => t('User'),
    ],
  ];

  $data['wa']['aaguid'] = [
    'title' => t('AAGUID'),
    'help' => t('Authenticator Attestation GUID.'),
    'field' => ['id' => 'standard'],
    'filter' => ['id' => 'string'],
    'sort' => ['id' => 'standard'],
  ];

  $data['wa']['provider_label'] = [
