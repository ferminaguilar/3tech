<?php

/**
 * @file
 * Contains wa.module.
 */

use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Database\Query\SelectInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\views\ViewExecutable;
use Drupal\wa\WaPermissions;

/**
 * Implements hook_form_alter().
 */
function wa_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'user_login_form') {
    $config = \Drupal::config('wa.settings');

    // Add cache tag so form is invalidated when config changes.
    $form['#cache']['tags'][] = 'config:wa.settings';

    if ($config->get('enable_passkey_login') === FALSE) {
      return;
    }

    $form['#attached']['library'][] = 'wa/passkey';

    $loginFieldsetTitle = $config->get('login_fieldset_title') ?? t('Sign in with Passkey');
    $loginFieldsetDescription = $config->get('login_fieldset_description') ?? '';

    $form['wa_login_method'] = [
      '#type' => 'fieldset',
      '#title' => $loginFieldsetTitle,
      '#description' => $loginFieldsetDescription,
      '#weight' => 100,
    ];

    $form['wa_login_method']['passkey_login'] = [
      '#type' => 'button',
      '#value' => t('Sign in with Passkey'),
      '#attributes' => [
        'id' => 'wa-login-btn',
        'class' => ['button', 'button--primary', 'wa--login'],
      ],
    ];

    $login_options_url = Url::fromRoute('wa.login_options')->toString();
    $login_verify_url = Url::fromRoute('wa.login_verify')->toString();

    $form['#attached']['drupalSettings']['wa'] = [
      'routes' => [
        'loginOptions' => $login_options_url,
        'loginVerify' => $login_verify_url,
      ],
    ];
  }
}

