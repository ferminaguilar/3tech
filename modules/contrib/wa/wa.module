  $data['wa']['id'] = [
    'title' => t('ID'),
    'help' => t('Unique credential ID.'),
    'field' => [
      'id' => 'numeric',
      'click sortable' => TRUE,
    ],
    'filter' => ['id' => 'numeric'],
    'sort' => ['id' => 'standard'],
  ];

  $data['wa']['uid'] = [
    'title' => t('User ID'),
    'help' => t('The {users}.uid that owns the credential.'),
    'field' => [
      'id' => 'numeric',
      'click sortable' => TRUE,
    ],
    'filter' => ['id' => 'numeric'],
    'sort' => ['id' => 'standard'],
    'relationship' => [
      'title' => t('User'),
      'help' => t('Relate passkeys to their owners.'),
      'id' => 'standard',
      'base' => 'users_field_data',
      'base field' => 'uid',
      'label' => t('User'),
    ],
  ];

  $data['wa']['aaguid'] = [
    'title' => t('AAGUID'),
    'help' => t('Authenticator Attestation GUID.'),
    'field' => ['id' => 'standard'],
    'filter' => ['id' => 'string'],
    'sort' => ['id' => 'standard'],
  ];

  $data['wa']['provider_label'] = [
    'title' => t('Provider'),
    'help' => t('Human-friendly authenticator/provider label.'),
    'field' => ['id' => 'wa_passkey_provider'],
    'filter' => ['id' => 'wa_passkey_provider'],
  ];

  $data['wa']['created'] = [
    'title' => t('Created'),
    'help' => t('Timestamp when the credential was created.'),
    'field' => ['id' => 'date'],
    'filter' => ['id' => 'date'],
    'sort' => ['id' => 'date'],
  ];

  $data['wa']['last_used'] = [
    'title' => t('Last used'),
    'help' => t('Timestamp when the credential was last used.'),
    'field' => ['id' => 'date'],
    'filter' => ['id' => 'date'],
    'sort' => ['id' => 'date'],
