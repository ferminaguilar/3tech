    'help' => t('Human-friendly authenticator/provider label.'),
    'field' => ['id' => 'wa_passkey_provider'],
    'filter' => ['id' => 'wa_passkey_provider'],
  ];

  $data['wa']['created'] = [
    'title' => t('Created'),
    'help' => t('Timestamp when the credential was created.'),
    'field' => ['id' => 'date'],
    'filter' => ['id' => 'date'],
    'sort' => ['id' => 'date'],
  ];

  $data['wa']['last_used'] = [
    'title' => t('Last used'),
    'help' => t('Timestamp when the credential was last used.'),
