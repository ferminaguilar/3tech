<?php

/**
 * @file
 * Install, update and uninstall functions for the wa_email_otp module.
 */

/**
 * Implements hook_schema().
 */
function wa_email_otp_schema(): array {
  $schema['wa_email_otp'] = [
    'description' => 'Stores OTP tokens for WA login verification.',
    'fields' => [
      'uid' => [
        'description' => 'The user ID.',
        'type' => 'int',
        'not null' => TRUE,
      ],
      'otp' => [
        'description' => 'The One-Time Password.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'hash' => [
        'description' => 'The unique hash for the URL.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ],
      'created' => [
        'description' => 'Timestamp when the OTP was created.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['hash'],
    'indexes' => [
      'uid' => ['uid'],
      'created' => ['created'],
    ],
  ];

  return $schema;
}
